# World Labs API Key (Tạo không gian 3D tương tác từ ảnh phối cảnh/thế giới game)
# Đăng ký tại: https://worldlabs.ai
WORLDLABS_API_KEY=WLT-...

# Meshy API Key (Tạo mô hình 3D thực tế có Texture cho Nhân vật & Đồ vật đơn lẻ)
# Lấy API key tại: https://www.meshy.ai
MESHY_API_KEY=msy_...

# DeepSeek API Key (Tạo mô hình hình khối Three.js Procedural bằng Code từ Prompt)
# Lấy API key tại: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Hyper3D Rodin API Key (Tùy chọn)
# Lấy API key tại: https://developer.hyper3d.ai
RODIN_API_KEY=vibecoding
